#!/usr/bin/env python3
"""Canonical general code review wrapper for Primus.

This wrapper runs bounded SDLC-style review lanes first, then feeds a compact
summary of those results into Grumpy for a hostile final pass. The result is a
single consolidated report suitable for local code-review use.
"""

from __future__ import annotations

