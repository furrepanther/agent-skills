DEFAULT_GRUMPY_MODEL = os.getenv("PRIMUS_GRUMPY_MODEL", CANONICAL_LOCAL_MODEL)
DEFAULT_INLINE_DOC_PROMPT = RUNTIME_ROOT / "prompts" / "inline_code_documenter_prompt_v0_1.md"
DEFAULT_INLINE_DOC_SCHEMA = RUNTIME_ROOT / "schemas" / "inline_code_documenter_result_schema_v0_1.json"
DEFAULT_COMPACT_LANE_PROMPT = RUNTIME_ROOT / "prompts" / "adversarial_code_checker_compact_retry_prompt_v1.md"
DEFAULT_COMPACT_LANE_SCHEMA = RUNTIME_ROOT / "schemas" / "adversarial_code_checker_compact_retry_schema_v1.json"
DEFAULT_COMPACT_GRUMPY_PROMPT = RUNTIME_ROOT / "prompts" / "grumpy_reviewer_compact_prompt_v1.md"
DEFAULT_REVIEW_TMPDIR = Path(os.getenv("PRIMUS_REVIEW_TMPDIR", "/tmp/primus-review"))
# The historical 3500-character ceiling was a compatibility guard, not a
# model/router capacity limit. It cannot carry the now-required verified
# temporary-evidence pointer for a complete packet. The measured canonical
# compatibility ceiling is 12000 characters; keep the older values as explicit
# rollback baselines only.
LEGACY_SAFE_LANE_REVIEW_CHARS = 3500
INTERMEDIATE_SAFE_LANE_REVIEW_CHARS = 4000
SAFE_LANE_REVIEW_CHARS = 12000
MAX_SAFE_LANE_REVIEW_CHARS = 12000
VALIDATED_LANE_REVIEW_CHAR_CAPS = (SAFE_LANE_REVIEW_CHARS,)
# Leave room for child-checker normalization and launcher-injected metadata.
LANE_COMPACTION_HEADROOM_CHARS = 100
MIN_SAFE_LANE_REVIEW_CHARS = 800
# SimpleMem rejects an individual memory_store content value above 131072
# characters. Child content is self-describing because the durable raw-entry
# readback may not expose metadata. Keep raw payloads low enough that JSON
# envelope escaping cannot approach the service limit.
TEMP_EVIDENCE_CHUNK_PAYLOAD_MAX_CHARS = 48_000
TEMP_EVIDENCE_CHUNK_PAYLOAD_MAX_UTF8_BYTES = 48_000
TEMP_EVIDENCE_STORE_MAX_CHARS = 120_000
TEMP_EVIDENCE_STORE_MAX_UTF8_BYTES = 120_000
# A complete source packet can legitimately exceed sixteen 48k records. Keep
# the manifest bounded, but large enough for the current multi-repository gate
# packet (~52 chunks) so source-complete review does not fail before dispatch.
MAX_TEMP_EVIDENCE_CHUNKS = 64
TEMP_EVIDENCE_CHUNK_MANIFEST_SCHEMA = "temporary_review_evidence_chunk_manifest_v2"
TEMP_EVIDENCE_CHUNK_ENVELOPE_SCHEMA = "temporary_review_evidence_chunk_v1"
# A pointer is not reviewer access by itself.  When the complete packet must
# live in Memory Fabric, hydrate a bounded, byte-verified source page into each
# lane handoff.  The page is deliberately small enough to coexist with the
# complete evidence index under the measured 12K lane ceiling; the parent
# pointer and page receipt prove that the rest of the bytes remain available
# through the typed continuation protocol.
# Keep a little more headroom for the typed evidence ledger and route receipt
# when the child envelope is at the hard 12K ceiling. The full source remains
# in the verified pointer; this is only the bounded reviewer-visible page.
SOURCE_REVIEW_PAGE_MAX_BYTES = 400
SOURCE_REVIEW_PAGE_SCHEMA = "source_review_page_v1"
# A lane may receive several byte-verified continuation pages.  The complete
# packet remains in the exact temporary pointer; these pages are the bounded
# reviewer-visible projection and must cover the material changed surfaces.
SOURCE_REVIEW_PAGE_MAX_PAGES = 8
# A three-byte prefix (for example ``#!/`` or ``\"\"\"``) is not useful
# reviewer-visible source evidence and is routinely misread as metadata-only
# delivery. Keep the sample bounded, but large enough to carry real context;
# complete bytes remain in the verified temporary pointer.
SOURCE_FILE_SAMPLE_MAX_BYTES = 32
def resolve_memory_api_url() -> str:
    """Resolve the canonical local Mem0 API without accepting endpoint drift."""
    configured = (
        os.getenv("PRIMUS_MEMORY_API_URL", "").strip()
        or os.getenv("ANTIGRAVITY_MEMORY_API_URL", "").strip()
        or os.getenv("MEMORY_API_URL", "").strip()
        or "http://127.0.0.1:8001"
    )
    parsed = urlparse(configured)
    if (
        parsed.scheme != "http"
        or parsed.username is not None
        or parsed.password is not None
        or parsed.hostname not in {"127.0.0.1", "localhost", "::1"}
        or parsed.query
        or parsed.fragment
    ):
        raise ValueError(
            "Red-Team Gate Memory Fabric endpoint must be an unauthenticated loopback HTTP URL"
        )
    return configured.rstrip("/")


MEMORY_API_URL = resolve_memory_api_url()
MEMORY_API_TIMEOUT_S = 10.0
TEMP_EVIDENCE_RETENTION_DAYS = 7
# Allows independently-started writers to converge on the first valid expiry
# without accepting a materially extended retention period.
TEMP_EVIDENCE_RETENTION_CLOCK_SKEW_SECONDS = 60
# SimpleMem's active HTTP limiter admits 100 requests per client IP per
# minute. Durable job status is an observation, not a progress deadline;
# polling at one request per second preserves evidence while leaving room for
# gateway session traffic and other local Memory Fabric callers.
MEMORY_ASYNC_POLL_INTERVAL_S = 1.0
MEMORY_GATEWAY_RECONNECT_BACKOFF_S = 1.0
SIMPLEMEM_RAW_ENTRY_NAMESPACE = uuid.NAMESPACE_URL
# Duplicate checks are fail-closed, but a transient search transport failure
# must not abort the review before a write is even attempted.  This is a
# bounded request retry, not a wall-clock job timeout or cancellation rule.
MEMORY_DUPLICATE_CHECK_ATTEMPTS = 3
MEMORY_DUPLICATE_CHECK_INTERVAL_S = 0.25
# These are post-terminal read probes for eventual Memory Fabric indexing, not
# a job timeout or cancellation rule. The write is already terminal before
# this bounded exact-identity reconciliation begins.
MEMORY_EXACT_RECONCILE_ATTEMPTS = 12
MEMORY_EXACT_RECONCILE_INTERVAL_S = 0.25
# Unknown terminal writes have no job identity to settle, so only exact
# content observations are safe. These are bounded observations, not a job
# deadline or cancellation path.
MEMORY_UNKNOWN_RECONCILE_ATTEMPTS = 4
MEMORY_UNKNOWN_RECONCILE_INTERVAL_S = 0.25
# A durable memory_store worker can briefly report TimeoutError before its
# terminal receipt settles to done. These are evidence observations, not a
# wall-clock job deadline or cancellation policy.
MEMORY_TIMEOUT_SETTLEMENT_OBSERVATIONS = 4
CONTEXT_ERROR_PATTERNS = (
    "exceeds the available context size",
    "context size exceeded",
    "review content too large",
    "n_ctx",
    "local_finish_reason_length",
    "requested generation hit its length limit",
    "model output could not be parsed as a json object",
    "unterminated string",
    "unexpected end of json",
)


class MemoryFabricTransportAmbiguousError(RuntimeError):
    """The gateway lost a response before proving whether a write was queued."""

    def __init__(self, *, detail: str, job_id: str = "") -> None:
        self.job_id = str(job_id or "").strip()
        self.detail = str(detail or "")
        super().__init__(self.detail)


class MemoryFabricTerminalWriteError(RuntimeError):
    """A durable write reached an explicit terminal state without a result."""

    def __init__(
        self,
        *,
        job_id: str,
        status: str,
        detail: str,
        transport_ambiguous: bool = False,
    ) -> None:
        self.job_id = job_id
        self.status = status
        self.detail = detail
        self.transport_ambiguous = transport_ambiguous
        super().__init__(
            f"Memory Fabric job {job_id} reached {status}: {detail[:1200]}"
        )

    @property
    def retryable_transport_failure(self) -> bool:
        if self.transport_ambiguous:
            return True
        detail = self.detail.lower()
        if self.status == "failed_terminal" and not detail.strip():
            # A terminal receipt with no diagnostic is an unknown backend
            # outcome, not proof of a semantic rejection. The caller has
            # already performed exact reconciliation; allow its one derived
            # idempotency-key repair attempt, then fail closed if that fails.
            return True
        return any(
            marker in detail
            for marker in (
                "server error '500",
                "server error '502",
                "server error '503",
                "server error '504",
                "closedresourceerror",
                "remote disconnected",
                "connection reset",
                "connection refused",
                "timed out",
                "timeout",
                "temporarily unavailable",
                "embedding",
            )
        )


class MemoryFabricPartialEvidenceError(RuntimeError):
    """A chunked evidence write stopped after verified children but before a manifest."""

    def __init__(
        self,
        *,
        child_refs: list[dict[str, Any]],
        purge_after_utc: str,
        detail: str,
    ) -> None:
        self.child_refs = tuple(dict(reference) for reference in child_refs)
        self.purge_after_utc = purge_after_utc
        super().__init__(detail)


def _terminal_detail(payload: dict[str, Any]) -> str:
    """Preserve an explicitly empty backend diagnostic as empty evidence."""
    for field in ("last_error", "error", "result"):
        if field not in payload:
            continue
        value = payload[field]
        if value is None:
            continue
        return str(value)
    return str(payload)


def load_json(path: Path) -> Any:
    with path.open("r", encoding="utf-8") as f:
        return json.load(f)


def load_json_or_error(path: Path, *, documentation: bool = False) -> tuple[Any | None, str]:
    try:
        result = load_json(path)
        if not isinstance(result, dict):
            raise ValueError("review output must be a JSON object")
        if documentation:
            if not isinstance(result.get("suggested_comments"), list):
                raise ValueError("documentation output lacks suggested_comments list")
        elif not isinstance(result.get("merge_decision"), dict) or result["merge_decision"].get("decision") not in {"block", "insufficient_evidence", "no_blocking_defect_found"} or not isinstance(result.get("findings"), list):
            raise ValueError("review output lacks valid merge_decision/findings")
        return result, ""
    except Exception as exc:
        return None, f"{type(exc).__name__}: {exc}"


def write_json(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def runtime_prompt_from_doc(prompt_doc: str) -> str:
    match = re.search(r"```text\s*(.*?)\s*```", prompt_doc, flags=re.DOTALL | re.IGNORECASE)
    if match:
        return match.group(1).strip()
    return prompt_doc.strip()


def compact_text(value: Any, max_chars: int) -> str:
    text = value if isinstance(value, str) else json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True)
    if max_chars <= 0 or len(text) <= max_chars:
        return text
    marker = f"\n\n[truncated to {max_chars} chars for local review context]\n"
    keep = max(0, max_chars - len(marker))
    return text[:keep].rstrip() + marker


def safe_review_chars(requested: int) -> int:
    """Return a lane budget within the measured reviewer compatibility cap."""
    requested_chars = int(requested)
    if requested_chars < MIN_SAFE_LANE_REVIEW_CHARS:
        LOGGER.warning(
            "review lane request below minimum; clamping requested=%d minimum=%d",
            requested_chars,
            MIN_SAFE_LANE_REVIEW_CHARS,
        )
    elif requested_chars > MAX_SAFE_LANE_REVIEW_CHARS:
        LOGGER.warning(
            "review lane request above canonical ceiling; clamping requested=%d ceiling=%d",
            requested_chars,
            MAX_SAFE_LANE_REVIEW_CHARS,
        )
    return min(max(requested_chars, MIN_SAFE_LANE_REVIEW_CHARS), MAX_SAFE_LANE_REVIEW_CHARS)


def validated_review_budget_candidates(requested_budget: int) -> tuple[int, ...]:
    """Return a caller tier plus validated larger lossless retry tiers.

    The caller-supplied tier is preserved after ordinary bound normalization;
    it is not an invented retry tier and may intentionally be below the
    canonical ceiling. Only larger tiers listed in
    ``VALIDATED_LANE_REVIEW_CHAR_CAPS`` may be appended for a
    no-lossless-representation retry. The canonical 12,000-character tier is
    currently the only validated larger tier, so a request at that ceiling
    deliberately returns one candidate and a lossless-fit failure remains
    blocking rather than silently shrinking required evidence.
    """
    initial_budget = safe_review_chars(requested_budget)
    return tuple(dict.fromkeys(
        (initial_budget,)
        + tuple(budget for budget in VALIDATED_LANE_REVIEW_CHAR_CAPS if budget > initial_budget)
    ))


def deep_copy_json(value: Any) -> Any:
    return json.loads(json.dumps(value, ensure_ascii=False))


