_COMMON_MCP_CLIENT: Any | None = None
_COMMON_MCP_CLIENT_LOCK = threading.RLock()


RUNTIME_ROOT = Path(os.getenv("PRIMUS_RED_TEAM_GATE_ROOT", Path(__file__).resolve().parent.parent))
DEFAULT_CONFIG = RUNTIME_ROOT / "config" / "reviewers.template.json"
DEFAULT_CHECKER = RUNTIME_ROOT / "bin" / "primus-adversarial-code-checker"
DEFAULT_GRUMPY = RUNTIME_ROOT / "bin" / "primus-grumpy-reviewer"
